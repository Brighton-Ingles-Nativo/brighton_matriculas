generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  permissions Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  users       User[]

  @@map("roles")
}

model User {
  id                           String                @id @default(uuid()) @db.Uuid
  username                     String                @unique
  email                        String                @unique
  password                     String
  name                         String
  picUser                      String?               @map("pic_user")
  active                       Boolean               @default(true)
  emailVerified                Boolean               @default(false) @map("email_verified")
  roleId                       String                @map("role_id") @db.Uuid
  createdAt                    DateTime              @default(now()) @map("created_at")
  updatedAt                    DateTime              @updatedAt @map("updated_at")
  role                         Role                  @relation(fields: [roleId], references: [id])
  supervisorId                 String?               @map("supervisor_id") @db.Uuid
  supervisor                   User?                 @relation("UserSupervision", fields: [supervisorId], references: [id], onDelete: Restrict)
  subordinates                 User[]                @relation("UserSupervision")
  sessions                     UserSession[]
  customers                    Customer[]            @relation("CustomerAdvisor")
  contracts                    Contract[]
  receipts                     Receipt[]
  siteSupervisions             SiteSupervisor[]
  teamSupervisions             TeamSupervisor[]
  teamMemberships              TeamMember[]
  notifications                Notification[]
  pushSubscriptions            PushSubscription[]
  cancellationRequestsMade     CancellationRequest[] @relation("CancellationRequestedBy")
  cancellationRequestsReviewed CancellationRequest[] @relation("CancellationReviewedBy")
  expedientObservations        Expedient[]           @relation("ExpedientObservationBy")
  responsibleExpedients        Expedient[]           @relation("ExpedientResponsible")
  expedientMovements            ExpedientMovement[]   @relation("ExpedientMovementActor")
  strategiesCreated            Strategy[]            @relation("StrategyCreatedBy")
  strategiesUpdated            Strategy[]            @relation("StrategyUpdatedBy")

  @@index([roleId])
  @@index([supervisorId])
  @@map("users")
}

model UserSession {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  rememberMe Boolean  @default(false) @map("remember_me")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model Notification {
  id          String    @id @default(uuid()) @db.Uuid
  recipientId String    @map("recipient_id") @db.Uuid
  type        String    @db.VarChar(80)
  title       String    @db.VarChar(160)
  message     String    @db.Text
  entityType  String?   @map("entity_type") @db.VarChar(50)
  entityId    String?   @map("entity_id") @db.Uuid
  actionUrl   String?   @map("action_url") @db.VarChar(500)
  priority    String    @default("normal") @db.VarChar(20)
  data        Json      @default("{}")
  dedupeKey   String?   @map("dedupe_key") @db.VarChar(180)
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  expiresAt   DateTime? @map("expires_at")
  recipient   User      @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  deliveries  NotificationDelivery[]

  @@unique([recipientId, dedupeKey])
  @@index([recipientId, readAt, createdAt])
  @@index([type, createdAt])
  @@index([entityType, entityId])
  @@map("notifications")
}

model NotificationDelivery {
  id             String       @id @default(uuid()) @db.Uuid
  notificationId String       @map("notification_id") @db.Uuid
  channel        String       @db.VarChar(30)
  status         String       @default("pending") @db.VarChar(20)
  attempts       Int          @default(0)
  sentAt         DateTime?     @map("sent_at")
  errorMessage   String?      @map("error_message") @db.Text
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([status, channel, createdAt])
  @@map("notification_deliveries")
}

model PushSubscription {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  endpoint   String    @db.Text
  p256dh     String    @db.Text
  auth       String    @db.Text
  userAgent  String?   @map("user_agent") @db.Text
  active     Boolean   @default(true)
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
  @@index([userId, active])
  @@map("push_subscriptions")
}

enum TeamModality {
  PRESENCIAL
  VIRTUAL

  @@map("modalidad_equipo")
}

enum ContractStatus {
  REVISION
  FIRMADO
  ANULADO
}

enum ExpedientStatus {
  CREADO
  REBOTADO
  AGENDADO
  OBSERVADO
  VERIFICADO
}

enum ExpedientLocation {
  ASESOR
  SUPERVISOR
  ASISTENTE_COMERCIAL
  VERIFICACION
}

model Site {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique @db.VarChar(100)
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  teams       Team[]
  supervisors SiteSupervisor[]

  @@map("sedes")
}

model Team {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique @db.VarChar(100)
  modality    TeamModality     @map("modalidad")
  siteId      String           @map("sede_id") @db.Uuid
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  site        Site             @relation(fields: [siteId], references: [id], onDelete: Restrict)
  supervisors TeamSupervisor[]
  members     TeamMember[]

  @@index([siteId])
  @@map("equipos")
}

model SiteSupervisor {
  id           String   @id @default(uuid()) @db.Uuid
  siteId       String   @map("sede_id") @db.Uuid
  supervisorId String   @map("supervisor_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  site         Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  supervisor   User     @relation(fields: [supervisorId], references: [id], onDelete: Restrict)

  @@unique([siteId, supervisorId])
  @@index([supervisorId])
  @@map("sedes_supervisores")
}

model TeamSupervisor {
  id           String   @id @default(uuid()) @db.Uuid
  teamId       String   @map("equipo_id") @db.Uuid
  supervisorId String   @map("supervisor_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  supervisor   User     @relation(fields: [supervisorId], references: [id], onDelete: Restrict)

  @@unique([teamId, supervisorId])
  @@index([supervisorId])
  @@map("equipos_supervisores")
}

model TeamMember {
  id        String   @id @default(uuid()) @db.Uuid
  teamId    String   @map("equipo_id") @db.Uuid
  userId    String   @map("usuario_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@map("equipos_usuarios")
}

model Strategy {
  id          String    @id @default(uuid()) @db.Uuid
  code        String?   @unique @db.VarChar(50)
  name        String    @unique @db.VarChar(150)
  description String?   @db.Text
  active      Boolean   @default(true)
  displayOrder Int      @default(0) @map("orden")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by_id") @db.Uuid
  updatedById String?   @map("updated_by_id") @db.Uuid
  createdBy   User?     @relation("StrategyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?     @relation("StrategyUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  contracts   Contract[] @relation("ContractStrategy")

  @@index([active, displayOrder])
  @@index([createdById])
  @@index([updatedById])
  @@map("estrategias")
}

model Customer {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String     @map("usuario_id") @db.Uuid
  name       String     @map("titular_nombre") @db.VarChar(200)
  birthDate  DateTime   @map("titular_fecha_nacimiento") @db.Date
  dni        String     @map("titular_dni") @db.VarChar(20)
  email      String     @map("titular_email") @db.VarChar(100)
  address    String     @map("titular_direccion") @db.VarChar(250)
  department String?    @map("titular_dep") @db.VarChar(100)
  province   String?    @map("titular_prov") @db.VarChar(100)
  district   String?    @map("titular_dist") @db.VarChar(100)
  phone      String     @map("titular_celular") @db.VarChar(20)
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  advisor    User       @relation("CustomerAdvisor", fields: [userId], references: [id], onDelete: Restrict)
  contracts  Contract[]
  students   Student[]

  @@index([userId])
  @@index([dni])
  @@map("clientes")
}

model Student {
  id          String            @id @default(uuid()) @db.Uuid
  customerId  String            @map("cliente_id") @db.Uuid
  name        String            @map("nombre") @db.VarChar(200)
  birthDate   DateTime?         @map("fecha_nacimiento") @db.Date
  dni         String?           @map("dni") @db.VarChar(20)
  email       String?           @map("email") @db.VarChar(100)
  phone       String?           @map("celular") @db.VarChar(20)
  customer    Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  enrollments ContractStudent[]

  @@index([customerId])
  @@index([dni])
  @@map("alumnos")
}

model Contract {
  id                  String               @id @default(uuid()) @db.Uuid
  userId              String               @map("usuario_id") @db.Uuid
  customerId          String               @map("cliente_id") @db.Uuid
  registeredAt        DateTime             @map("fecha_registro")
  contractDepartment  String?              @map("contrato_dep") @db.VarChar(100)
  contractProvince    String?              @map("contrato_prov") @db.VarChar(100)
  contractDistrict    String?              @map("contrato_dist") @db.VarChar(100)
  contractNumber      String               @unique @map("nro_contrato") @db.VarChar(20)
  strategyId          String?              @map("estrategia_id") @db.Uuid
  strategyNameSnapshot String?             @map("estrategia_nombre") @db.VarChar(150)
  paymentStartDate    String?              @map("fecha_inicio_pago") @db.VarChar(20)
  modality            String?              @map("modalidad") @db.VarChar(20)
  program             String               @map("programa") @db.VarChar(20)
  plan                String?              @db.VarChar(50)
  cashPayment         Boolean              @default(false) @map("modalidad_contado")
  financedPayment     Boolean              @default(false) @map("modalidad_financiado")
  programValue        Decimal              @map("valor_programa") @db.Decimal(10, 2)
  initialPayment      Decimal?             @default(0) @map("cuota_inicial") @db.Decimal(10, 2)
  balance             Decimal?             @map("saldo") @db.Decimal(10, 2)
  installmentCount    Int?                 @map("nro_cuotas")
  installmentValue    Decimal?             @map("valor_cuota") @db.Decimal(10, 2)
  otherPayment        String?              @map("otro_pago") @db.VarChar(100)
  status              ContractStatus       @default(REVISION) @map("estado")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  signedAt            DateTime?            @map("firmado_at")
  signedIp            String?              @map("firmado_ip") @db.VarChar(45)
  accessToken         String?              @unique @map("access_token") @db.VarChar(64)
  tokenExpiresAt      DateTime?            @map("token_expiration")
  user                User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  customer            Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  students            ContractStudent[]
  receipts            Receipt[]
  otherData           ContractOtherData?
  expedient           Expedient?
  cancellationRequest CancellationRequest?
  strategyDefinition  Strategy?            @relation("ContractStrategy", fields: [strategyId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([customerId])
  @@index([strategyId])
  @@index([tokenExpiresAt])
  @@map("contratos")
}

model Expedient {
  id                       String              @id @default(uuid()) @db.Uuid
  contractId               String              @unique @map("contrato_id") @db.Uuid
  status                   ExpedientStatus     @default(CREADO)
  currentLocation          ExpedientLocation   @map("ubicacion_actual")
  responsibleId            String?             @map("responsable_id") @db.Uuid
  createdAt                DateTime            @default(now()) @map("created_at")
  updatedAt                DateTime            @updatedAt @map("updated_at")
  sentToCommercialAt       DateTime?           @map("enviado_comercial_at")
  sentToVerificationAt     DateTime?           @map("enviado_verificacion_at")
  verifiedAt               DateTime?           @map("verificado_at")
  firstContactAt           DateTime?           @map("primer_contacto_at")
  observation              String?             @map("observacion") @db.Text
  observationAt            DateTime?           @map("observacion_at")
  observationById          String?             @map("observacion_by_id") @db.Uuid
  appointmentAt            DateTime?           @map("cita_at")
  appointmentRescheduledAt DateTime?           @map("cita_reprogramada_at")
  appointmentType          String?             @map("tipo_cita") @db.VarChar(20)
  advisoryRating           Int?                @map("calificacion_asesoria")
  strategyConfirmed        Boolean?            @map("estrategia_confirmada")
  strategyObservation      String?             @map("estrategia_observacion") @db.Text
  advisorValidationConfirmed Boolean?          @map("asesor_validacion_confirmado")
  advisorValidationName    String?             @map("asesor_validacion_nombre") @db.VarChar(200)
  classStartDate           DateTime?           @map("inicio_clases_at")
  paymentDate              DateTime?           @map("fecha_pago")
  contract                 Contract            @relation(fields: [contractId], references: [id], onDelete: Cascade)
  documents                ExpedientDocument[]
  observationBy            User?               @relation("ExpedientObservationBy", fields: [observationById], references: [id], onDelete: SetNull)
  responsible              User?               @relation("ExpedientResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  movements                ExpedientMovement[]

  @@index([status])
  @@index([observationById])
  @@map("expedientes")
}

model ExpedientMovement {
  id             String             @id @default(uuid()) @db.Uuid
  expedientId    String             @map("expediente_id") @db.Uuid
  fromStatus     ExpedientStatus?   @map("estado_anterior")
  toStatus       ExpedientStatus?   @map("estado_nuevo")
  fromLocation   ExpedientLocation? @map("ubicacion_anterior")
  toLocation     ExpedientLocation? @map("ubicacion_nueva")
  userId         String             @map("usuario_id") @db.Uuid
  observation    String?            @db.Text
  createdAt      DateTime           @default(now()) @map("created_at")

  expedient Expedient @relation(fields: [expedientId], references: [id], onDelete: Cascade)
  user      User      @relation("ExpedientMovementActor", fields: [userId], references: [id], onDelete: Restrict)

  @@index([expedientId, createdAt])
  @@map("expediente_movimientos")
}

model CancellationRequest {
  id            String    @id @default(uuid()) @db.Uuid
  contractId    String    @unique @map("contrato_id") @db.Uuid
  requestedById String    @map("solicitado_por") @db.Uuid
  reviewedById  String?   @map("revisado_por") @db.Uuid
  reason        String    @db.Text
  reviewNote    String?   @map("observacion_revision") @db.Text
  status        String    @default("PENDIENTE") @db.VarChar(20)
  createdAt     DateTime  @default(now()) @map("created_at")
  reviewedAt    DateTime? @map("revisado_at")
  contract      Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  requestedBy   User      @relation("CancellationRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy    User?     @relation("CancellationReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([requestedById])
  @@map("solicitudes_anulacion")
}

model ExpedientDocument {
  id          String    @id @default(uuid()) @db.Uuid
  expedientId String    @map("expediente_id") @db.Uuid
  type        String    @db.VarChar(40)
  fileName    String    @map("nombre_archivo") @db.VarChar(255)
  filePath    String    @map("ruta_archivo") @db.VarChar(500)
  mimeType    String    @map("tipo_mime") @db.VarChar(100)
  fileSize    Int?      @map("tamano_archivo")
  uploadedAt  DateTime  @default(now()) @map("cargado_at")
  expedient   Expedient @relation(fields: [expedientId], references: [id], onDelete: Cascade)

  @@index([expedientId])
  @@map("expediente_documentos")
}

model ContractStudent {
  id         String   @id @default(uuid()) @db.Uuid
  contractId String   @map("contrato_id") @db.Uuid
  studentId  String   @map("alumno_id") @db.Uuid
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([contractId, studentId])
  @@index([studentId])
  @@map("contratos_alumnos")
}

model ContractOtherData {
  id                String   @id @default(uuid()) @db.Uuid
  contractId        String   @unique @map("contrato_id") @db.Uuid
  currentSituation  String   @map("situacion_actual") @db.VarChar(20)
  housingType       String   @map("tipo_vivienda") @db.VarChar(20)
  dataAuthorization Boolean  @default(false) @map("autorizacion_datos")
  strategy          String   @map("estrategia") @db.VarChar(50)
  notes             String?  @map("observaciones") @db.Text
  testimonials      Boolean  @default(false) @map("testimonios")
  dataUsage         Boolean? @map("uso_datos")
  contract          Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@map("contratos_otros_datos")
}

model Receipt {
  id              String    @id @default(uuid()) @db.Uuid
  contractId      String    @map("contrato_id") @db.Uuid
  userId          String    @map("usuario_id") @db.Uuid
  registeredRole  String?   @map("rol_registro") @db.VarChar(20)
  amount          Decimal?  @map("cuota_inicial") @db.Decimal(10, 2)
  concepts        String?   @map("conceptos") @db.VarChar(255)
  otherConcept    String?   @map("otros_concepto") @db.VarChar(255)
  paymentMethod   String?   @map("forma_pago") @db.VarChar(50)
  operationNumber String?   @map("nro_operacion") @db.VarChar(50)
  bank            String?   @map("banco") @db.VarChar(50)
  transactionDate DateTime? @map("fecha_transaccion") @db.Date
  registeredAt    DateTime  @default(now()) @map("fecha_registro")
  contract        Contract  @relation(fields: [contractId], references: [id], onDelete: Restrict)
  user            User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([contractId])
  @@index([userId])
  @@map("recibos")
}
