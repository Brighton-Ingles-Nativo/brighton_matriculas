DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/brighton?schema=public"
# El seed legacy debe ejecutarse una sola vez después de prisma migrate deploy.
SEED_DATABASE=false
# Configure only when email sending is connected to an application flow.
MAIL_ENABLED="false"
MAIL_FROM=""
MAIL_FROM_NAME="Brighton Inglés Nativo"
AWS_REGION="us-east-1"
AWS_BUCKET_NAME=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Generate with: pnpm exec web-push generate-vapid-keys
VAPID_SUBJECT="mailto:admin@example.com"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
